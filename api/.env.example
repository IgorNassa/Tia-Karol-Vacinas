# Banco Supabase: use o Session pooler (porta 5432) com SSL.
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.oclhnqrseyiajyjtlxms
DATABASE_PASSWORD=SUBSTITUA_PELA_SENHA_DO_BANCO
DATABASE_MAX_POOL_SIZE=10
DATABASE_MIN_IDLE=1
DATABASE_CONNECTION_TIMEOUT_MS=30000

# Valores publicos do projeto Supabase.
SUPABASE_URL=https://oclhnqrseyiajyjtlxms.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_PELA_CHAVE_PUBLICA

# Primeiro usuario administrativo da API.
BOOTSTRAP_ADMIN_EMAIL=admin@tiakarol.local
BOOTSTRAP_ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
BOOTSTRAP_ADMIN_NAME=Administrador

# Sessões opacas: somente os hashes são armazenados no banco.
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7

# Segurança HTTP. Liste origens exatas, separadas por vírgula; curingas são recusados.
CORS_ALLOWED_ORIGINS=https://app.exemplo.com.br
AUTH_RATE_LIMIT_PER_MINUTE=20
OPENAPI_DOCS_ENABLED=true
OPENAPI_UI_ENABLED=false
SERVER_PORT=8080
